# ─────────────────────────────────────────────────────────────────────────────
# YVY · Variables de entorno
# ─────────────────────────────────────────────────────────────────────────────
# Copiar este archivo como .env y completar valores:
#   cp .env.example .env
#
# El archivo .env NO se commitea (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Modo de ejecución ───────────────────────────────────────────────────────
# Valores: "dev" | "prod"
# En "dev" se permiten cosas como debug logging y bootstrap simplificado.
YVY_ENV=dev

# ─── Base de datos local ─────────────────────────────────────────────────────
# Path absoluto al archivo SQLite
YVY_DB_PATH=./data/yvy.sqlite

# ─── Identidad de la estación (se llena durante onboarding) ──────────────────
# IMPORTANTE: estos valores se generan/cargan durante el wizard de onboarding,
# no se setean manualmente en .env (excepto en dev).
YVY_STATION_UUID=
YVY_STATION_CUE=
YVY_STATION_CUISE=
YVY_STATION_NAME=

# ─── Servidor central (sync target) ──────────────────────────────────────────
YVY_SERVER_URL=https://yvy-central.misiones.gob.ar
YVY_API_KEY=

# ─── Bootstrap del superadmin (SOLO PRIMER ARRANQUE) ─────────────────────────
# Una vez que la app arranca y crea el superadmin, estas vars dejan de usarse.
# NUNCA dejar valores en producción tras el primer boot.
# El sistema se NIEGA a arrancar si YVY_SUPERADMIN_PASS no está definida
# (excepto en dev con YVY_DEV=1).
YVY_SUPERADMIN_USER=superadmin_yvy
YVY_SUPERADMIN_PASS=

# ─── pywws / sensor ──────────────────────────────────────────────────────────
# Path donde pywws guarda los datos del sensor
YVY_PYWWS_DATA_PATH=./pywws_data

# Modo de pywws: "live" (USB activo) o "stub" (mock para tests)
YVY_PYWWS_MODE=stub

# ─── Sync agent ──────────────────────────────────────────────────────────────
# Intervalo entre ciclos de sync (segundos). Default: 60
YVY_SYNC_INTERVAL_SECONDS=60

# Tope máximo de items por batch
YVY_SYNC_BATCH_SIZE=10

# ─── Logging ─────────────────────────────────────────────────────────────────
# Nivel: DEBUG | INFO | WARNING | ERROR
YVY_LOG_LEVEL=INFO
YVY_LOG_PATH=./data/logs/yvy.log

# ─── NTP ─────────────────────────────────────────────────────────────────────
# Si está en true, la app verifica NTP al boot y muestra warning si no está activo
YVY_REQUIRE_NTP=true
