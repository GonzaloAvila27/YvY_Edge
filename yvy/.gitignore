.ruff_cache/
.pyre/

# ──────────────────────────────────────────────────────────────────────────────
# Datos en runtime (NO commitear)
# ──────────────────────────────────────────────────────────────────────────────
data/yvy.sqlite
data/yvy.sqlite-wal
data/yvy.sqlite-shm
data/yvy.sqlite-journal
data/exports/*.zip
data/logs/*.log
data/logs/*.log.*
data/update_backups/*

# Pero conservar la estructura de carpetas
!data/exports/.gitkeep
!data/logs/.gitkeep
!data/update_backups/.gitkeep

# ──────────────────────────────────────────────────────────────────────────────
# Configuración local
# ──────────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
config.local.toml

